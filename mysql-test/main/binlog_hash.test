--source include/binlog_combinations.inc
--source include/have_innodb.inc
--source include/not_windows.inc
--source include/not_embedded.inc

let $datadir= `select @@datadir`;
set @old_binlog_gtid_pos_cache= @@global.binlog_gtid_pos_cache;
set @@global.binlog_gtid_pos_cache= 2;

select @@gtid_binlog_pos;
create table t1 (a int primary key, b int) engine=innodb;
select @@gtid_binlog_pos;
insert t1 values (1,1),(3,3),(5,5),(7,7);
select @@gtid_binlog_pos;
set @@session.gtid_domain_id= 222;
create table t2 (m int);
select @@gtid_binlog_pos;
insert t2 values (1);
select @@gtid_binlog_pos;
update t1 set b=50 where b=5;
set @@session.gtid_domain_id= 333;
select @@gtid_binlog_pos;
update t1 set b=10 where a=5;
flush binary logs;
select @@gtid_binlog_pos;
update t1 set b=20 where a= 5;

# Note: you can check GTID positions from binlog files:
# --exec $MYSQL_BINLOG --verbose $datadir/master-bin.000001

--move_file $datadir/master-bin.000001 $datadir/mister-bin.000001
set @@global.binlog_gtid_pos_cache= 0;
--error 29
select binlog_gtid_pos('master-bin.000001', 3);
set @@global.binlog_gtid_pos_cache= 1;
# Note: no error when there is no file means cache hit
select binlog_gtid_pos('master-bin.000001', 3);
select binlog_gtid_pos('master-bin.000001', 4);
select binlog_gtid_pos('master-bin.000001', 255);
select binlog_gtid_pos('master-bin.000001', 256);
select binlog_gtid_pos('master-bin.000001', 329);
select binlog_gtid_pos('master-bin.000001', 371);
select binlog_gtid_pos('master-bin.000001', 419);
select binlog_gtid_pos('master-bin.000001', 461);
select binlog_gtid_pos('master-bin.000001', 503);
select binlog_gtid_pos('master-bin.000001', 545);
select binlog_gtid_pos('master-bin.000001', 652);
select binlog_gtid_pos('master-bin.000001', 683);
select binlog_gtid_pos('master-bin.000001', 725);
select binlog_gtid_pos('master-bin.000001', 824);
select binlog_gtid_pos('master-bin.000001', 866);
select binlog_gtid_pos('master-bin.000001', 953);
select binlog_gtid_pos('master-bin.000001', 1026);
select binlog_gtid_pos('master-bin.000001', 1068);
select binlog_gtid_pos('master-bin.000001', 1163);
select binlog_gtid_pos('master-bin.000001', 1194);
select binlog_gtid_pos('master-bin.000001', 1236);
select binlog_gtid_pos('master-bin.000001', 1331);
select binlog_gtid_pos('master-bin.000001', 1362);
select binlog_gtid_pos('master-bin.000002', 4);
select binlog_gtid_pos('master-bin.000002', 256);
select binlog_gtid_pos('master-bin.000002', 375);
select binlog_gtid_pos('master-bin.000002', 417);
--move_file $datadir/mister-bin.000001 $datadir/master-bin.000001

--echo # Check binlog_hash rotation
--move_file $datadir/master-bin.000002 $datadir/mister-bin.000002
select binlog_gtid_pos('master-bin.000002', 4);
set @@global.binlog_gtid_pos_cache= 0;
--error 29
select binlog_gtid_pos('master-bin.000002', 4);
set @@global.binlog_gtid_pos_cache= 1;
select binlog_gtid_pos('master-bin.000002', 4);
flush binary logs;
--error 29
select binlog_gtid_pos('master-bin.000002', 4);
--move_file $datadir/mister-bin.000002 $datadir/master-bin.000002
select binlog_gtid_pos('master-bin.000002', 4);
select binlog_gtid_pos('master-bin.000002', 256);
select binlog_gtid_pos('master-bin.000002', 375);
select binlog_gtid_pos('master-bin.000002', 417);

set @@global.binlog_gtid_pos_cache= 12;
flush binary logs; flush binary logs; flush binary logs; flush binary logs;
flush binary logs; flush binary logs; flush binary logs; flush binary logs;
flush binary logs; flush binary logs; flush binary logs; flush binary logs;
flush binary logs; flush binary logs; flush binary logs; flush binary logs;

--list_files $datadir *ster-bin.*
--move_file $datadir/master-bin.000007 $datadir/mister-bin.000007
--move_file $datadir/master-bin.000008 $datadir/mister-bin.000008
# 07 is not in cache while 08 is still in cache
--error 29
select binlog_gtid_pos('master-bin.000007', 4);
select binlog_gtid_pos('master-bin.000008', 4);
--move_file $datadir/mister-bin.000007 $datadir/master-bin.000007
--move_file $datadir/mister-bin.000008 $datadir/master-bin.000008

set @@global.binlog_gtid_pos_cache= 3;
flush binary logs;

--echo # Check row format
--source include/have_binlog_format_row.inc
insert t2 values (2);
set @@session.gtid_domain_id= 44;
update t2 set m= 3;
set @@session.gtid_domain_id= 55;
insert t2 values (4);
set @@session.gtid_domain_id= 66;
delete from t2;

# --list_files $datadir
# --exec $MYSQL_BINLOG --verbose $datadir/master-bin.000020

--move_file $datadir/master-bin.000020 $datadir/mister-bin.000020
select binlog_gtid_pos('master-bin.000020', 4);
select binlog_gtid_pos('master-bin.000020', 256);
select binlog_gtid_pos('master-bin.000020', 331);
select binlog_gtid_pos('master-bin.000020', 375);
select binlog_gtid_pos('master-bin.000020', 417);
select binlog_gtid_pos('master-bin.000020', 460);
select binlog_gtid_pos('master-bin.000020', 505);
select binlog_gtid_pos('master-bin.000020', 543);
select binlog_gtid_pos('master-bin.000020', 616);
select binlog_gtid_pos('master-bin.000020', 658);
select binlog_gtid_pos('master-bin.000020', 699);
select binlog_gtid_pos('master-bin.000020', 744);
select binlog_gtid_pos('master-bin.000020', 798);
select binlog_gtid_pos('master-bin.000020', 871);
select binlog_gtid_pos('master-bin.000020', 913);
select binlog_gtid_pos('master-bin.000020', 956);
select binlog_gtid_pos('master-bin.000020', 1001);
select binlog_gtid_pos('master-bin.000020', 1039);
select binlog_gtid_pos('master-bin.000020', 1112);
select binlog_gtid_pos('master-bin.000020', 1154);
select binlog_gtid_pos('master-bin.000020', 1191);
select binlog_gtid_pos('master-bin.000020', 1236);
select binlog_gtid_pos('master-bin.000020', 1284);
--move_file $datadir/mister-bin.000020 $datadir/master-bin.000020

drop table t1,t2;
set @@global.binlog_gtid_pos_cache= @old_binlog_gtid_pos_cache;
